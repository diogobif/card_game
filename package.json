{
  "name": "card_game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "concurrently -k -n web,server -c blue,magenta \"vite\" \"pnpm dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.ts",
    "start:server": "node server/index.ts",
    "start": "node server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "art": "node scripts/generate-art.ts",
    "check": "node scripts/jira-agent/checks.ts",
    "agent:jira": "node scripts/jira-agent/index.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@langchain/anthropic": "1.6.1",
    "@langchain/core": "1.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "jsdom": "31.0.0",
    "langchain": "1.6.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
